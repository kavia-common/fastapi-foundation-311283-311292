{"is_source_file": true, "format": "Python", "description": "This file defines data models using Pydantic for a FastAPI backend related to data product management. It includes models for error responses, dataset references, metadata, draft submissions, approvals, validations, and publishing workflows.", "external_files": ["pydantic", "typing"], "external_methods": [], "published": ["StandardError", "GateFailureError", "DatasetRef", "DataProductMetadata", "DraftSubmissionRequest", "Draft", "DraftSubmissionResponse", "ValidationRunRequest", "ApprovalSignature", "ApprovalDecisionRequest", "ApprovalDecision", "PublishRequest", "PublishResponse", "ValidationRunBody", "ApprovalDecisionBody", "PublishBody"], "classes": [{"name": "StandardError", "description": "Standardized error response model including error code, message, correlation ID, timestamp, retry flag, and optional details."}, {"name": "GateFailureError", "description": "An error model for mandatory gate failures, extending StandardError with optional details."}, {"name": "DatasetRef", "description": "Model capturing dataset reference URI and optional checksum."}, {"name": "DataProductMetadata", "description": "Metadata associated with a data product, including name, description, domain, classification, schema version, source, lineage, update frequency, critical columns, and max age seconds."}, {"name": "DraftSubmissionRequest", "description": "Request model for submitting a draft, including dataset reference, metadata, and submission channel. Contains a method to identify missing required metadata fields."}, {"name": "Draft", "description": "Model representing a draft with identifiers, state, submitter info, dataset and metadata, and optional quality report version."}, {"name": "DraftSubmissionResponse", "description": "Response model containing the submitted draft and correlation ID."}, {"name": "ValidationRunRequest", "description": "Request to trigger validation runs, with a flag for executing the full suite